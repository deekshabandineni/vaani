# Copy to .env. Never commit the real .env.
JWT_SECRET=change-me-to-a-long-random-string
# Azure AI Speech (optional; enables cloud scoring + fusion). Free tier works for development.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
# Weight of Azure vs. the local model when both score an attempt (0..1)
FUSION_AZURE_WEIGHT=0.6
